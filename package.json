{
  "name": "spinoza-ethics-reader",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://rdaum.github.io/ethica",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "n3": "^2.13.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:latin": "node scripts/generate-latin.mjs",
    "generate:corpus": "node scripts/generate-corpus.mjs && node scripts/generate-latin.mjs",
    "deploy": "npm run build && gh-pages -d build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^13.4.0",
    "@types/n3": "^1.16.4",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdaum/ethica.git"
  },
  "bugs": {
    "url": "https://github.com/rdaum/ethica/issues"
  },
  "license": "MIT",
  "type": "module"
}
